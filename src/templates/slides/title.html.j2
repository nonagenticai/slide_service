{% extends "base.html.j2" %}
{% block style %}
.slide { background: var(--primary); display: flex; align-items: center; }
.accent-bar { position: absolute; top: 0; left: 0; width: 24px; height: 100%; background: var(--secondary); }
.body { width: 100%; min-width: 0; padding: 0 12vw 0 14vw; max-width: none; }
.eyebrow {
  font-size: var(--type-kicker, 1.6rem); font-weight: 600; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--secondary); margin-bottom: 2.5vh;
}
.title {
  font-size: var(--type-display, clamp(2.5rem, 6.2vw, 6rem)); line-height: 1.04; font-weight: 800;
  color: #fff; text-wrap: balance; overflow-wrap: anywhere;
}
.subtitle {
  margin-top: 3.5vh; font-size: var(--type-body, clamp(1.4rem, 2.4vw, 2.4rem)); line-height: 1.35;
  font-weight: 400; color: rgba(255, 255, 255, 0.82); text-wrap: pretty; overflow-wrap: anywhere;
}
{% endblock %}
{% block content %}
<div class="slide">
  <div class="accent-bar"></div>
  <div class="body">
    {% if eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}
    <div class="title">{{ title }}</div>
    {% if subtitle %}<div class="subtitle">{{ subtitle }}</div>{% endif %}
  </div>
</div>
{% endblock %}
