{% extends "base.html.j2" %}
{% block style %}
.slide { background: var(--surface, #f8fafc); display: flex; }
.left { flex: 1; padding: 8vh 4vw 8vh 5vw; display: flex; flex-direction: column; justify-content: center; }
/* No image resolved: the right panel is omitted, so the text becomes a deliberate
   full-width slide (centered measure) instead of a left-hugged half with a placeholder. */
.left.full { padding: 8vh 8vw; max-width: 62vw; margin: 0 auto; }
.left .title {
  font-size: var(--type-h1, clamp(2rem, 3.4vw, 3.2rem)); font-weight: 800; color: var(--primary);
  line-height: 1.1; text-wrap: balance;
}
.left .desc {
  margin-top: 3vh; font-size: var(--type-body, clamp(1.2rem, 1.8vw, 1.8rem));
  color: var(--on-surface, #2d3748); line-height: 1.45;
}
.left .bullets { margin-top: 3vh; list-style: none; display: flex; flex-direction: column; gap: 1.6vh; }
.left .bullets li {
  position: relative; padding-left: 2.2rem;
  font-size: var(--type-body, clamp(1.1rem, 1.6vw, 1.6rem));
  color: var(--on-surface, #2d3748); line-height: 1.4; text-wrap: pretty;
}
.left .bullets li::before {
  content: ""; position: absolute; left: 0; top: 0.55em;
  width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--accent);
}
.pill {
  align-self: flex-start; margin-top: 4vh; padding: 0.7rem 1.6rem; border-radius: 999px;
  background: var(--primary); color: #fff; font-size: 1.2rem; font-weight: 700;
}
.right { flex: 1; position: relative; }
.right.bleed { background: #e6ecf3; }
.right.framed { padding: 6vh 5vw 6vh 0; }
.frame { width: 100%; height: 100%; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #e6ecf3; }
.right.framed .frame { border-radius: 18px; border: 2px solid #dae2ea; }
.frame img { width: 100%; height: 100%; }
{% endblock %}
{% block content %}
<div class="slide">
  <div class="left{% if not (image and image.has_image) %} full{% endif %}">
    <div class="title">{{ title }}</div>
    {% if description %}<div class="desc">{{ description }}</div>{% endif %}
    {% if bullets %}<ul class="bullets">{% for b in bullets %}<li>{{ b }}</li>{% endfor %}</ul>{% endif %}
    {% if pill %}<div class="pill">{{ pill }}</div>{% endif %}
  </div>
  {% if image and image.has_image %}
  <div class="right{% if image.full_bleed %} bleed{% else %} framed{% endif %}">
    <div class="frame"><img src="{{ image.data_uri }}" style="object-fit: {{ image.object_fit }};" alt="{{ title }}"></div>
  </div>
  {% endif %}
</div>
{% endblock %}
