{% extends "base.html.j2" %}
{% block style %}
.slide {
  background: var(--primary, #0B1F3A);
  padding: var(--grid-margin, 8vw);
  display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
}
.eyebrow {
  font-size: var(--type-kicker, 1.5rem); font-weight: 600; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--accent, #F26B3A); margin-bottom: 3vh;
  display: flex; align-items: center; gap: 1.4vw;
}
.eyebrow::after {
  content: ""; display: inline-block; width: 6vw; height: 3px;
  background: var(--accent, #F26B3A);
}
.title {
  font-size: var(--type-display, clamp(2.8rem, 6vw, 6rem)); line-height: 1.04; font-weight: 800;
  color: #fff; text-wrap: balance; overflow-wrap: anywhere; max-width: 82vw;
}
.items {
  list-style: none; margin-top: 6vh; padding: 0; max-width: 74vw;
  display: flex; flex-direction: column; gap: var(--grid-gutter, 2vh);
}
.items li {
  font-size: var(--type-body, clamp(1.3rem, 2vw, 2rem)); line-height: 1.3;
  color: rgba(255, 255, 255, 0.85); text-wrap: balance; overflow-wrap: anywhere;
  display: flex; align-items: baseline; gap: 1.6vw; counter-increment: item;
}
.items li::before {
  content: counter(item, decimal-leading-zero);
  color: var(--accent, #F26B3A); font-weight: 700;
  font-size: var(--type-kicker, 1.5rem); flex: 0 0 auto;
}
{% endblock %}
{% block content %}
<div class="slide">
  {% if eyebrow %}<div class="eyebrow">{{ eyebrow }}</div>{% endif %}
  <div class="title">{{ title }}</div>
  {% if items %}
  <ol class="items" style="counter-reset: item;">
    {% for it in items %}<li>{{ it }}</li>{% endfor %}
  </ol>
  {% endif %}
</div>
{% endblock %}
