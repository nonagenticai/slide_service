<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<style>
{% if display_font_uri %}
@font-face {
  font-family: '{{ display_font }}';
  src: url({{ display_font_uri }}) format('woff2');
  font-weight: 100 900;
  font-style: normal;
  font-display: block;
}
{% endif %}
{% if body_font_uri and body_font != display_font %}
@font-face {
  font-family: '{{ body_font }}';
  src: url({{ body_font_uri }}) format('woff2');
  font-weight: 100 900;
  font-style: normal;
  font-display: block;
}
{% endif %}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { width: 100vw; height: 100vh; overflow: hidden; }
:root {
  {#- Design-system tokens (surface / type scale / grid), validated + kebab-cased in
      html_slide_renderer._css_tokens. Emitted generically so a NEW token needs no
      template change. No tokens => nothing is emitted here and every template's
      var(--x, <literal>) fallback wins => byte-identical to the pre-token render.

      Emitted BEFORE the brand channel on purpose. The token map carries an
      `accent` key, which kebab-cases onto the same `--accent` the brand channel
      declares — and a later declaration of the same custom property wins the
      cascade. The brand channel must win those names: apply_design_tokens()
      already folds the design system INTO it with a deliberate mapping
      (accent_color = palette.accent_2, not palette.accent), and consumers like
      cta's accent-circle use a bare var(--accent) with no fallback. Emitting the
      loop last would silently override that mapping. -#}
{%- for token_name, token_value in (tokens or {}).items() %}
  --{{ token_name }}: {{ token_value }};
{%- endfor %}
  --primary: {{ primary }};
  --secondary: {{ secondary }};
  --accent: {{ accent }};
  --font-display: "{{ display_font }}", "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --font-body: "{{ body_font }}", "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  /* Back-compat alias: templates predating the display/body split use var(--font). */
  --font: var(--font-body);
}
body {
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}
/* Titles use the display face brand-wide; child templates set size/weight/color
   but not font-family, so this cascades to every family's .title. */
.title { font-family: var(--font-display); }
.slide { width: 100vw; height: 100vh; position: relative; overflow: hidden; }
{% if dropped_note %}
/* Degraded marker. Declared in BASE, not per family, so a family added later
   inherits it without an edit: the loss is announced by construction rather
   than by remembering. Mirrors BaseTemplateRenderer._add_degraded_marker on the
   PPTX side — same sentence, same red, same "malformed input" wording — so a
   slide and its PNG preview never disagree about what was lost. Absolutely
   positioned and only emitted when something WAS lost, so a healthy slide is
   byte-identical to the pre-marker render. */
.degraded-marker {
  position: absolute; left: 0; right: 0; bottom: 0; z-index: 99;
  padding: 1.2vh 3vw; text-align: center;
  font-family: var(--font-body); font-style: italic;
  font-size: clamp(0.9rem, 1.2vw, 1.2rem); line-height: 1.3;
  color: #B3261E; background: rgba(255, 255, 255, 0.92);
  border-top: 3px solid #B3261E;
}
{% endif %}
{% block style %}{% endblock %}
</style>
</head>
<body>
{% block content %}{% endblock %}
{%- if dropped_note %}
<div class="degraded-marker">&#9888; {{ dropped_note }}</div>
{%- endif %}
</body>
</html>
