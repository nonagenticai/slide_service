{% extends "base.html.j2" %}
{% block style %}
.slide {
  background: var(--surface, #0B1F3A);
  padding: var(--grid-margin, 6vw);
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; text-align: center;
}
.value {
  font-family: var(--font-display);
  font-size: var(--type-display, clamp(5rem, 16vw, 15rem));
  line-height: 0.95; font-weight: 800;
  color: var(--accent, #F26B3A);
  overflow-wrap: anywhere; max-width: 100%;
}
.label {
  margin-top: 4vh;
  font-size: var(--type-h1, clamp(1.8rem, 3.2vw, 3rem));
  line-height: 1.1; font-weight: 700;
  color: var(--on-surface, #fff);
  text-wrap: balance; overflow-wrap: anywhere; max-width: 90%;
}
.caption {
  margin-top: 3vh;
  font-size: var(--type-body, clamp(1.2rem, 1.8vw, 1.8rem));
  line-height: 1.4; font-weight: 400;
  color: var(--on-surface-muted, rgba(255, 255, 255, 0.7));
  text-wrap: pretty; overflow-wrap: anywhere; max-width: 72%;
}
{% endblock %}
{% block content %}
<div class="slide">
  {% if value %}<div class="value">{{ value }}</div>{% endif %}
  {% if label %}<div class="label">{{ label }}</div>{% endif %}
  {% if caption %}<div class="caption">{{ caption }}</div>{% endif %}
</div>
{% endblock %}
