{% extends "base.html.j2" %}
{% block style %}
.slide {
  background: var(--surface, #f8fafc); padding: var(--grid-margin, 6vw);
  display: flex; flex-direction: column;
}
.title {
  font-size: var(--type-h1, clamp(2rem, 3.6vw, 3.4rem)); font-weight: 800;
  color: var(--primary, #0B1F3A); margin-bottom: 4vh;
  text-wrap: pretty; overflow-wrap: anywhere;
}
.cols {
  display: grid; grid-template-columns: 1fr 1fr;
  column-gap: var(--grid-gutter, 4vw); flex: 1; min-height: 0;
}
.col { display: flex; flex-direction: column; min-height: 0; }
.col.right {
  border-left: 1px solid var(--accent-soft, rgba(11, 31, 58, 0.12));
  padding-left: var(--grid-gutter, 4vw);
}
.col.left {
  border-right: 2px solid var(--accent-soft, rgba(11, 31, 58, 0.12));
  padding-right: var(--grid-gutter, 4vw);
}
.heading {
  font-size: var(--type-h2, clamp(1.5rem, 2.4vw, 2.2rem)); font-weight: 700;
  color: var(--accent, #F26B3A); margin-bottom: 2vh;
  text-wrap: pretty; overflow-wrap: anywhere;
}
.body {
  font-size: var(--type-body, clamp(1.2rem, 1.8vw, 1.8rem));
  color: var(--on-surface, #101418); line-height: 1.45; margin-bottom: 2vh;
  text-wrap: pretty; overflow-wrap: anywhere;
}
.bullets {
  list-style: none; font-size: var(--type-caption, clamp(1rem, 1.4vw, 1.4rem));
  color: var(--on-surface-muted, #57647a); line-height: 1.5;
}
.bullets li {
  position: relative; padding-left: 1.4em; margin-bottom: 1vh;
  text-wrap: pretty; overflow-wrap: anywhere;
}
.bullets li::before {
  content: "\2022"; position: absolute; left: 0;
  color: var(--accent, #F26B3A); font-weight: 700;
}
{% endblock %}
{% block content %}
{% macro column(side, data) -%}
  <div class="col {{ side }}">
    {% if data.heading %}<div class="heading">{{ data.heading }}</div>{% endif %}
    {% if data.body %}<div class="body">{{ data.body }}</div>{% endif %}
    {% if data.bullets %}
    <ul class="bullets">
      {% for b in data.bullets %}<li>{{ b }}</li>{% endfor %}
    </ul>
    {% endif %}
  </div>
{%- endmacro %}
<div class="slide">
  {% if title %}<div class="title">{{ title }}</div>{% endif %}
  <div class="cols">
    {{ column("left", left or {}) }}
    {{ column("right", right or {}) }}
  </div>
</div>
{% endblock %}
